param D;  # Спрос в единицах в неделю
param S;  # Стоимость размещения одного заказа
param C;  # Закупочная стоимость единицы товара
param h;  # Стоимость хранения единицы товара в неделю
param p;  # Стоимость дефицита за единицу товара в неделю

# Переменные
var Q >= 0;  # Оптимальный размер заказа
var F >= 0;  # Частота размещения заказов

# Целевая функция: минимизация общих затрат (размещение + хранение + дефицит)
minimize TotalCost:
    S * (D / Q) + h * Q / 2 + (if p > 0 then p * (D / Q) else 0);

# Ограничение: размер заказа
subject to OrderSize:
    Q = sqrt(2 * D * S / h) * (if p > 0 then sqrt(1 + h / p) else 1);

# Ограничение: частота размещения заказов
subject to Frequency:
    F = D / Q;
