model 9_lebedev_lab2.mod;
data 9_lebedev_lab2.dat;

option solver cplex;

solve;

printf "================================================\n";
printf "Общая минимальная стоимость перевозки: %d у.е.\n", Total_Cost;
printf "================================================\n\n";
printf "Оптимальный план перевозок (количество машин):\n";
printf "------------------------------------------------\n";
printf "  Маршрут      | Количество машин\n";
printf "------------------------------------------------\n";
for {(i,j) in ARCS: Flow[i,j] > 0} {
    printf "  %s -> %s        | %d\n", i, j, Flow[i,j];
}
printf "------------------------------------------------\n";