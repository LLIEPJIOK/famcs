@page
@model app.Pages.Rosters.IndexModel

@{
    ViewData["Title"] = "Список игроков";
}

<style>
    body {
        background-color: #f8f9fa;
    }
    .container {
        max-width: 1200px;
    }
    h2 {
        font-weight: 700;
    }
    .table thead {
        background-color: #343a40;
        color: #fff;
    }
    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }
    .btn {
        margin-right: 5px;
    }
</style>

<div class="container mt-4">
    <h2 class="mb-4">Список игроков</h2>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Players[0].Jersey)</th>
                <th>@Html.DisplayNameFor(model => model.Players[0].FirstName)</th>
                <th>@Html.DisplayNameFor(model => model.Players[0].SecondName)</th>
                <th>@Html.DisplayNameFor(model => model.Players[0].Position)</th>
                <th>@Html.DisplayNameFor(model => model.Players[0].Weight)</th>
                <th>@Html.DisplayNameFor(model => model.Players[0].Height)</th>
                <th>@Html.DisplayNameFor(model => model.Players[0].BirthCity)</th>
                <th>@Html.DisplayNameFor(model => model.Players[0].BirthState)</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Players)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Jersey)</td>
                    <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                    <td>@Html.DisplayFor(modelItem => item.SecondName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Position)</td>
                    <td>@Html.DisplayFor(modelItem => item.Weight)</td>
                    <td>@Html.DisplayFor(modelItem => item.Height)</td>
                    <td>@Html.DisplayFor(modelItem => item.BirthCity)</td>
                    <td>@Html.DisplayFor(modelItem => item.BirthState)</td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-page="./Details" asp-route-id="@item.PlayerId">Просмотр</a>
                        <a class="btn btn-sm btn-warning" asp-page="./Edit" asp-route-id="@item.PlayerId">Редактировать</a>
                        <a class="btn btn-sm btn-danger" asp-page="./Delete" asp-route-id="@item.PlayerId">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a class="btn btn-primary" asp-page="./Create">
        <i class="fas fa-plus"></i> Добавить игрока
    </a>
</div>