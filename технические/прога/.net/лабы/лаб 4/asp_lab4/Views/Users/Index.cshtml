@model IEnumerable<asp_lab4.Areas.Identity.Data.User>
@{
    ViewData["Title"] = "Users List";
}
<h1>Users</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>User Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.UserName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-info btn-sm">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
