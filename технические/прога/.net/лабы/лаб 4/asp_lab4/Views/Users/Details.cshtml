@model asp_lab4.Areas.Identity.Data.User
@{
    ViewData["Title"] = "User Details";
    var roles = ViewBag.Roles as IList<string>;
}
<h1>Details for @Model.Email</h1>
<dl class="row">
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">User Name</dt>
    <dd class="col-sm-10">@Model.UserName</dd>
    <dt class="col-sm-2">Roles</dt>
    <dd class="col-sm-10">
        @if (roles != null && roles.Any())
        {
            <ul>
                @foreach (var r in roles)
                {
                    <li>@r</li>
                }
            </ul>
        }
        else
        {
            <em>No roles assigned.</em>
        }
    </dd>
</dl>
<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>