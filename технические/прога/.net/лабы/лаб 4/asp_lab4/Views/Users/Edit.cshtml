@model asp_lab4.Areas.Identity.Data.User
@{
    ViewData["Title"] = "Edit User";
    var allRoles = ViewBag.AllRoles as IList<string>;
    var userRoles = ViewBag.UserRoles as IList<string>;
}
<h1>Edit @Model.Email</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="form-group">
        <label asp-for="Email">Email</label>
        <input type="email" name="email" value="@Model.Email" class="form-control" required />
    </div>
    <fieldset class="form-group">
        <legend>Roles</legend>
        @if (allRoles != null)
        {
            foreach (var r in allRoles)
            {
                var isChecked = userRoles != null && userRoles.Contains(r);
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="roles" value="@r" id="role_@r" @(isChecked ? "checked" : "") />
                    <label class="form-check-label" for="role_@r">@r</label>
                </div>
            }
        }
    </fieldset>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>